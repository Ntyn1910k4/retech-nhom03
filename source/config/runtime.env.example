# Sao chép thành .dev.vars ở thư mục source khi chạy local.
# npm run setup:local tự tạo một ADMIN_BOOTSTRAP_TOKEN ngẫu nhiên nếu chưa có.
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-secret

# Chỉ cần hai biến sau nếu bật hội thoại AI gọi công cụ.
# Bộ danh mục, giao dịch và định giá theo dữ liệu hoạt động khi không có khóa.
OPENAI_API_KEY=
OPENAI_MODEL=
